{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/starfield17/NEOCR-Paddle/schemas/model-package.schema.json",
  "title": "NEOCR Paddle model package",
  "type": "object",
  "required": ["schemaVersion", "packageKind", "id", "version", "license", "models", "parity", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageKind": { "const": "model" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "models": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["role", "name", "sourceUrl", "sha256", "sourceDirectory", "inputName", "inputShape"],
        "properties": {
          "role": { "enum": ["documentOrientation", "documentUnwarping", "textLineOrientation", "textDetection", "textRecognition"] },
          "name": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sourceDirectory": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "inputName": { "type": "string", "minLength": 1 },
          "inputShape": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "integer", "minimum": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
